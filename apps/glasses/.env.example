# Copy to .env.local. Leave VITE_API_BASE empty (or VITE_MOCK=1) for offline mock data.
# The device token is NOT configured here: it is never bundled. Provide it at runtime by
# opening the app once with ?token=<DEVICE_TOKEN> (see README); without it the app runs in mock mode.
VITE_API_BASE=http://localhost:3300
VITE_MOCK=
