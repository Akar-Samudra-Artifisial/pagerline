# Copy to .env.local and fill in. Never commit real values.

# Local Postgres (see README: Homebrew cluster on 5433 or podman).
DATABASE_URL=postgres://pagerline:pagerline@localhost:5433/pagerline

# Static bearer token the glasses app sends (temporary, until pairing lands).
DEVICE_TOKEN=

# Comma-separated origins allowed to call /api/alerts from the glasses WebView.
GLASSES_ORIGINS=http://localhost:5173

# GitHub webhook secret (repo/org webhook settings).
GITHUB_WEBHOOK_SECRET=

# Sentry integration client secret (signs Sentry-Hook-Signature).
SENTRY_CLIENT_SECRET=

# Used by scripts/demo-seed.
SERVER_URL=http://localhost:3300
